---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatter = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<Base title="Writing" description="Posts by Patrick Linton.">
  <h1 class="font-serif text-3xl tracking-tight">Writing</h1>

  {
    posts.length === 0 && (
      <p class="text-ink-muted dark:text-ink-muted-dark mt-8">
        Nothing published yet.
      </p>
    )
  }

  <ul class="mt-10 space-y-8">
    {
      posts.map((post) => (
        <li>
          <a
            class="font-serif text-accent dark:text-accent-dark text-xl
                   hover:underline underline-offset-4"
            href={`/blog/${post.id}`}
          >
            {post.data.title}
          </a>
          <p class="text-ink-muted dark:text-ink-muted-dark mt-1 text-sm">
            <time datetime={post.data.date.toISOString()}>
              {formatter.format(post.data.date)}
            </time>
          </p>
          <p class="text-ink-muted dark:text-ink-muted-dark mt-2">
            {post.data.description}
          </p>
        </li>
      ))
    }
  </ul>
</Base>
