---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <h1 class="font-serif text-3xl tracking-tight">Not found</h1>
  <p class="text-ink-muted dark:text-ink-muted-dark mt-6">
    That page doesn't exist. Try the <a
      class="text-accent dark:text-accent-dark hover:underline"
      href="/">home page</a
    >.
  </p>
</Base>
